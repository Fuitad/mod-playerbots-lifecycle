[worldserver]

# Starts one guarded random bot account cleanup pass.
# The default leaves cleanup disabled.
PlayerbotsLifecycle.CleanupRequested = 0

# Confirmation digest for random bot deletion. Leave this empty for the first run.
# The server prints the complete account and character cohort with its digest, then stops without deleting anything.
# Copy that digest here and restart only after inspecting the cohort. A changed cohort invalidates the digest.
PlayerbotsLifecycle.CleanupConfirmation = ""

# Account ids whose characters must never be deleted, separated by commas.
# The cleanup refuses an empty list. Every configured id must match an existing account, must own at least
# one character, and no character owned by such an account may fall inside the deletion cohort.
# An account owning no character is refused: it guards nothing, and an unreadable character query looks the
# same as an empty one.
# Protection is account scoped on purpose: every character the account owns is covered, including ones
# created after this was configured, so a new alt is guarded without editing this file.
PlayerbotsLifecycle.ProtectedAccounts = ""
